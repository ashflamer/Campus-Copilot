# Copy to .env (never commit .env) or set these in your terminal before starting.

# ---- Gemma 4 ----
GEMMA_PROVIDER=ollama          # ollama | google | none
GEMMA_MODEL=gemma4:e4b         # ollama tag; for google use e.g. gemma-4-31b-it
OLLAMA_URL=http://localhost:11434
GOOGLE_API_KEY=                # only for GEMMA_PROVIDER=google (aistudio.google.com)
GEMMA_TIMEOUT=30               # seconds before falling back to rules
GEMMA_EXPLAIN=0                # 1 = Gemma re-words navigator answers (facts only)

# ---- Ports ----
NAV_PORT=8765                  # backend/navigator-api (also serves frontend/navigator-ui)
API_PORT=8766                  # backend/assignments-api
UI_PORT=5173                   # frontend/workspace-ui
NAV_URL=http://localhost:8765  # where assignments-api finds the navigator
